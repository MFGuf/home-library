<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Форма добавления/редактирования раздела библиотеки (категории).
    Контроллер разметки — CategoryFormController.
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.home.library.ui.CategoryFormController"
      styleClass="form-root" spacing="12" prefWidth="470" prefHeight="240">

    <GridPane hgap="10" vgap="6">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
        </columnConstraints>
        <Label text="Название *:"/>
        <TextField fx:id="nameField" promptText="Например, Беллетристика" GridPane.columnIndex="1"/>
        <Label text="Описание:" GridPane.rowIndex="1"/>
        <TextArea fx:id="descriptionField" prefRowCount="5" wrapText="true"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>
</VBox>